name: CI
on: [push, pull_request]

jobs:
  lint-validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install -r requirements-ci.txt

      - name: Check notebook outputs stripped
        run: find . -name "*.ipynb" -not -path "*/.ipynb_checkpoints/*" -not -path "*/investigation/*" -not -path "*/kiro-*" -exec nbstripout --verify {} +

      - name: Lint with ruff
        uses: astral-sh/ruff-action@v3
        with:
          args: "check --output-format=github ."

      - name: Validate notebook JSON
        run: python scripts/validate_notebooks.py
