import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from matplotlib.patches import FancyBboxPatch

fig, ax = plt.subplots(figsize=(13, 8))
fig.patch.set_facecolor('#1a1a2e')
ax.set_facecolor('#1a1a2e')
ax.set_xlim(0, 13)
ax.set_ylim(0, 8)
ax.axis('off')

ax.text(6.5, 7.6, 'nbstripout --verify vs --dry-run: Critical Distinction', fontsize=14,
        fontweight='bold', color='white', ha='center')

# Two columns
for col, (title, flag, color, exit_code, ci_ok, desc_lines) in enumerate([
    ('WRONG for CI', '--dry-run', '#e74c3c', 'Always exits 0', 'NO',
     ['Prints what would change', 'Never fails the pipeline', 'Silent pass even with outputs', 'Useless for enforcement']),
    ('CORRECT for CI', '--verify', '#27ae60', 'Non-zero if changes needed', 'YES',
     ['Implies --dry-run behavior', 'Exits non-zero when outputs found', 'Fails CI as intended', 'Enforces clean commits']),
]):
    x = 1.0 + col * 6.5

    # Header box
    hbox = FancyBboxPatch((x, 6.5), 5.5, 0.9, boxstyle='round,pad=0.15',
                           facecolor=color, edgecolor='white', lw=2)
    ax.add_patch(hbox)
    ax.text(x+2.75, 7.05, title, fontsize=13, fontweight='bold', color='white', ha='center', va='center')

    # Flag box
    fbox = FancyBboxPatch((x, 5.6), 5.5, 0.7, boxstyle='round,pad=0.1',
                           facecolor='#2c3e50', edgecolor=color, lw=2)
    ax.add_patch(fbox)
    ax.text(x+2.75, 5.95, f'nbstripout {flag}', fontsize=12, color='#00d4ff',
            ha='center', va='center', fontfamily='monospace')

    # Exit code
    ebox = FancyBboxPatch((x, 4.8), 5.5, 0.65, boxstyle='round,pad=0.1',
                           facecolor='#16213e', edgecolor='#555', lw=1)
    ax.add_patch(ebox)
    ax.text(x+2.75, 5.125, f'Exit code: {exit_code}', fontsize=10, color=color,
            ha='center', va='center', fontweight='bold')

    # CI badge
    badge_color = '#27ae60' if ci_ok == 'YES' else '#e74c3c'
    badge = FancyBboxPatch((x+1.5, 4.1), 2.5, 0.55, boxstyle='round,pad=0.1',
                            facecolor=badge_color, edgecolor='white', lw=1.5)
    ax.add_patch(badge)
    ax.text(x+2.75, 4.375, f'CI Enforcement: {ci_ok}', fontsize=10, color='white',
            ha='center', va='center', fontweight='bold')

    # Description bullets
    for i, line in enumerate(desc_lines):
        y = 3.5 - i * 0.55
        ax.text(x+0.3, y, f'• {line}', fontsize=9, color='#cccccc', va='center')

# Bottom note
note_box = FancyBboxPatch((0.5, 0.2), 12, 0.6, boxstyle='round,pad=0.1',
                           facecolor='#16213e', edgecolor='#00d4ff', lw=1.5)
ax.add_patch(note_box)
ax.text(6.5, 0.5, 'Source: Debian manpage — confirmed by 3 independent investigation streams',
        fontsize=9, color='#00d4ff', ha='center', va='center')

plt.savefig('/Users/murivirg/work/github/aws-samples/investigation/d1f13164/diagram_nbstripout.png',
            dpi=150, bbox_inches='tight', facecolor='#1a1a2e')
plt.close()
print("done")
