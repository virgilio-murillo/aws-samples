import json, os
nb_files = []
for root, dirs, files in os.walk('.'):
    if '.ipynb_checkpoints' in root or 'investigation' in root:
        continue
    for f in files:
        if f.endswith('.ipynb'):
            path = os.path.join(root, f)
            try:
                with open(path) as fh:
                    nb = json.load(fh)
                cells = nb.get('cells', [])
                code_cells = [c for c in cells if c.get('cell_type') == 'code']
                md_cells = [c for c in cells if c.get('cell_type') == 'markdown']
                kernel = nb.get('metadata', {}).get('kernelspec', {}).get('display_name', 'unknown')
                size = os.path.getsize(path)
                nb_files.append({'path': path, 'code_cells': len(code_cells), 'md_cells': len(md_cells), 'kernel': kernel, 'size_kb': round(size/1024, 1)})
            except Exception as e:
                nb_files.append({'path': path, 'error': str(e)})
for nb in sorted(nb_files, key=lambda x: x.get('size_kb', 0), reverse=True):
    print(json.dumps(nb))
